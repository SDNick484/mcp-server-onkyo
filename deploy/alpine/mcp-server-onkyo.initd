#!/sbin/openrc-run
# OpenRC service for mcp-server-onkyo (Streamable HTTP), e.g. in an Alpine LXC.
# Installed as /etc/init.d/mcp-server-onkyo by install.sh. Settings live in
# /etc/mcp-server-onkyo/ (config.json for receivers, env for HTTP and
# Cloudflare Access); this script only runs the server as its own user.

name="mcp-server-onkyo"
description="MCP server for Onkyo AV receivers, over Streamable HTTP"

# supervise-daemon restarts the server if it exits (respawn_* below).
supervisor="supervise-daemon"
# run.sh loads /etc/mcp-server-onkyo/env, then execs `mcp-server-onkyo serve --http`.
# A wrapper instead of conf.d exports: it works the same whichever supervisor
# runs it, and `run.sh` alone reproduces exactly what the service runs.
command="/opt/mcp-server-onkyo/run.sh"
command_user="mcp-onkyo:mcp-onkyo"
directory="/var/lib/mcp-server-onkyo"
output_log="/var/log/mcp-server-onkyo/server.log"
error_log="/var/log/mcp-server-onkyo/server.log"
respawn_delay=5
respawn_max=10
respawn_period=300

# Stopping: SIGTERM, up to 15 s to shut down cleanly, then SIGKILL (OpenRC's default is SIGTERM/5).
# Shutdown takes about 2 s (uvicorn's drain), so 15 s is headroom.
# supervise-daemon reads this at start: the restart that installs it still stops the old way.
retry="SIGTERM/15/SIGKILL/5"

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner mcp-onkyo:mcp-onkyo /var/log/mcp-server-onkyo /var/lib/mcp-server-onkyo
}
